# Required
HYPERINDEX_URL= # Hyperindex GraphQL endpoint (required)

# Optional Configuration
PORT=3000                           # Server port (optional, default: 3000) - Only needed if you want to change the default port
HTTP_TIMEOUT_SECS=30               # Request timeout in seconds (optional, default: 30) - Only needed if you want to change the default timeout
SCHEMA_REFRESH_COOLDOWN_SECS=30    # Minimum seconds between schema refreshes (optional, default: 30) - Only needed if you want to change how often schema can refresh

# Optional - Debug/Subgraph Comparison
# These are only needed if you want to compare converter results with the original subgraph for debugging
SUBGRAPH_DEBUG_URL=                # URL for subgraph comparison on errors (optional) - Only needed for debugging failed queries
SUBGRAPH_BEARER_TOKEN=             # Bearer token for subgraph auth (optional) - Only needed if SUBGRAPH_DEBUG_URL requires Bearer auth
SUBGRAPH_API_KEY=                  # API key for subgraph auth (optional) - Only needed if SUBGRAPH_DEBUG_URL requires API key auth
SUBGRAPH_AUTH_HEADER=              # Custom auth header name (optional) - Only needed if SUBGRAPH_DEBUG_URL requires custom header auth
SUBGRAPH_AUTH_VALUE=               # Custom auth header value (optional) - Only needed if SUBGRAPH_AUTH_HEADER is set
THEGRAPH_API_KEY=                  # Alternative API key (optional) - Only needed as fallback if SUBGRAPH_API_KEY is not set
